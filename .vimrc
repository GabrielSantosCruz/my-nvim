" ativar a numeração na lateral e ficarem relativos a linha atual
set number
set relativenumber

" 256 cores na tela
set t_Co=256

" tema
syntax on
colorscheme unokai

fazer com que a a aréa de transferência se una a do pc
set clipboard=unnamedplus

" macros

let @c = "I//\<Esc>j"
let @u = "<80>khvlx"
